# ==================== CONFIGURACIÓN DE IA ====================
# Proveedor de IA: groq (gratis), openai (de pago), demo (sin IA real)
AI_PROVIDER=groq

# Groq API Key (GRATIS - Obtén en: https://console.groq.com/keys)
GROQ_API_KEY=gsk_tu-groq-api-key-aqui

# OpenAI API Key (DE PAGO - Solo si usas AI_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-tu-openai-api-key-aqui

# ==================== BASE DE DATOS ====================
DATABASE_URL=postgresql://user:password@localhost/dbname

# ==================== SEGURIDAD ====================
SECRET_KEY=tu-secret-key-aqui
