              "mode": "formdata",
              "formdata": [
                {
                  "key": "archivo",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "idioma_origen",
                  "value": "es",
                  "type": "text"
                },
                {
                  "key": "idioma_destino",
                  "value": "en",
