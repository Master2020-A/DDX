                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paciente_id\": \"{{paciente_id}}\",\n  \"tipo_resumen\": \"completo\",\n  \"periodo_dias\": 90,\n  \"incluir_consultas\": true,\n  \"incluir_laboratorios\": true,\n  \"incluir_imagenes\": true,\n  \"incluir_medicamentos\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/pln/generar-resumen",
              "host": ["{{base_url}}"],
              "path": ["pln", "generar-resumen"]
            }
          },
          "response": []
        },
        {
          "name": "Resumen Ejecutivo (30 días)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paciente_id\": \"{{paciente_id}}\",\n  \"tipo_resumen\": \"ejecutivo\",\n  \"periodo_dias\": 30,\n  \"incluir_consultas\": true,\n  \"incluir_laboratorios\": true,\n  \"incluir_imagenes\": false,\n  \"incluir_medicamentos\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/pln/generar-resumen",
              "host": ["{{base_url}}"],
              "path": ["pln", "generar-resumen"]
            }
          },
          "response": []
        },
        {
          "name": "Resumen por Problema",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paciente_id\": \"{{paciente_id}}\",\n  \"tipo_resumen\": \"por_problema\",\n  \"periodo_dias\": 180,\n  \"problema_especifico\": \"Hipertensión arterial\",\n  \"incluir_consultas\": true,\n  \"incluir_laboratorios\": true,\n  \"incluir_imagenes\": true,\n  \"incluir_medicamentos\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/pln/generar-resumen",
              "host": ["{{base_url}}"],
              "path": ["pln", "generar-resumen"]
            }
          },
          "response": []
        },
        {
          "name": "Obtener Resúmenes de Paciente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pln/resumenes/paciente/{{paciente_id}}?limit=5",
              "host": ["{{base_url}}"],
              "path": ["pln", "resumenes", "paciente", "{{paciente_id}}"],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
