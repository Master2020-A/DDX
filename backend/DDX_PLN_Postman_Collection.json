{
  "info": {
    "name": "DDX - Módulo PLN",
    "description": "Colección de endpoints para el módulo de Procesamiento de Lenguaje Natural",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8612/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "paciente_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Autenticación",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "    console.log('Token guardado:', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ddx.com\",\n  \"password\": \"tu_password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Transcripción de Voz",
      "item": [
        {
          "name": "Transcribir Audio (sin extracción)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "archivo",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "paciente_id",
                  "value": "{{paciente_id}}",
                  "type": "text"
                },
                {
                  "key": "idioma",
                  "value": "es",
                  "type": "text"
                },
                {
                  "key": "extraer_informacion",
                  "value": "false",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/pln/transcribir-audio",
              "host": ["{{base_url}}"],
              "path": ["pln", "transcribir-audio"]
            }
          },
          "response": []
        },
        {
          "name": "Transcribir Audio (con extracción)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "archivo",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "paciente_id",
                  "value": "{{paciente_id}}",
                  "type": "text"
                },
                {
                  "key": "idioma",
                  "value": "es",
                  "type": "text"
                },
                {
                  "key": "extraer_informacion",
                  "value": "true",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/pln/transcribir-audio",
              "host": ["{{base_url}}"],
              "path": ["pln", "transcribir-audio"]
            }
          },
          "response": []
        },
        {
          "name": "Obtener Transcripciones de Paciente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pln/transcripciones/paciente/{{paciente_id}}?limit=10",
              "host": ["{{base_url}}"],
              "path": ["pln", "transcripciones", "paciente", "{{paciente_id}}"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Extracción de Información",
      "item": [
        {
          "name": "Extraer de Nota de Evolución",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Paciente masculino de 45 años con cefalea intensa de 3 días de evolución, acompañada de náuseas y fotofobia. Niega fiebre. Antecedentes de migraña. PA: 120/80 mmHg, FC: 72 lpm, Temp: 36.5°C. Se prescribe Sumatriptán 50mg VO cada 24h por 3 días.\",\n  \"tipo_documento\": \"nota_evolucion\",\n  \"paciente_id\": \"{{paciente_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pln/extraer-informacion",
              "host": ["{{base_url}}"],
              "path": ["pln", "extraer-informacion"]
            }
          },
          "response": []
        },
        {
          "name": "Extraer de Receta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Rx: Amoxicilina 500mg VO cada 8 horas por 7 días. Paracetamol 500mg VO cada 6 horas PRN dolor. Omeprazol 20mg VO cada 24 horas en ayunas por 14 días.\",\n  \"tipo_documento\": \"receta\",\n  \"paciente_id\": \"{{paciente_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pln/extraer-informacion",
              "host": ["{{base_url}}"],
              "path": ["pln", "extraer-informacion"]
            }
          },
          "response": []
        },
        {
          "name": "Extraer Entidades Nombradas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Paciente con diabetes mellitus tipo 2 en tratamiento con metformina. Presenta hipertensión arterial controlada con enalapril.\",\n  \"paciente_id\": \"{{paciente_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pln/extraer-entidades",
              "host": ["{{base_url}}"],
              "path": ["pln", "extraer-entidades"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Generación de Resúmenes",
      "item": [
        {
          "name": "Resumen Completo (90 días)",
          "request": {
            "method": "POST",
            "header": [
