              "raw": "{{base_url}}/pln/traducir-documento",
              "host": ["{{base_url}}"],
              "path": ["pln", "traducir-documento"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Diccionario Médico",
      "item": [
