# ========================================
# CONFIGURACIÓN DE N8N
# ========================================

# URL base de webhooks de N8N
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# URL de la API de N8N (para monitoreo)
N8N_API_URL=http://localhost:5678/api/v1

# API Key de N8N (generar en N8N UI)
N8N_API_KEY=

# Habilitar webhooks de N8N
N8N_WEBHOOKS_ENABLED=true

# Timeout para webhooks (segundos)
N8N_WEBHOOK_TIMEOUT=5

# ========================================
# INSTRUCCIONES
# ========================================
# 1. Copiar este archivo a .env
# 2. Instalar N8N: docker-compose up -d (ver docker-compose.n8n.yml)
# 3. Acceder a N8N: http://localhost:5678
# 4. Generar API key en N8N Settings → API
# 5. Pegar API key en N8N_API_KEY
# 6. Reiniciar backend de DDX
